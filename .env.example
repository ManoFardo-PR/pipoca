# Copie para .env (gitignored) e preencha as chaves reais.
# Modelos já preenchidos com defaults válidos confirmados na doc oficial de
# cada provedor (jul/2026) — troque se quiser outro tier.
# Hoje usado pelo experimento em experimentos/beats-para-paragrafos/
# (Script 1 = gerador via Gemini, Script 2 = avaliador via OpenAI).

# Script 1 (gerador) — https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=coloque_sua_chave_aqui
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.4

# Script 2 (avaliador, Camada 2) — https://developers.openai.com/api/docs/models
OPENAI_API_KEY=coloque_sua_chave_aqui
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TEMPERATURE=0.1

# Opcionais (têm default no código se omitidos)
# PLAYTHROUGHS_POR_NIVEL=6
# TAMANHO_LOTE=10
# SEED_BASE=
# MODO_VARIANCIA=

# Copie para .env (gitignored) e preencha as chaves reais.
# Chaves dos provedores de IA para desenvolvimento local (scripts de smoke e
# a camada src/ia). Em produção, as chaves vivem nos secrets das Edge
# Functions / na tabela chaves_ia — nunca neste arquivo.
# Modelos já preenchidos com defaults válidos confirmados na doc oficial de
# cada provedor (jul/2026) — troque se quiser outro tier.

# Gemini — https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=coloque_sua_chave_aqui
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.4

# OpenAI — https://developers.openai.com/api/docs/models
OPENAI_API_KEY=coloque_sua_chave_aqui
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TEMPERATURE=0.1

# Anthropic e DeepSeek — usados SÓ pelas Edge Functions (functions/*: SECRET_POR_PROVEDOR)
# via `supabase secrets set`; o cliente é keyless e a camada src/ia local não os lê.
# Listados aqui para o inventário de secrets ficar completo (Plan03 · A4).
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Opcionais (têm default no código se omitidos)
# PLAYTHROUGHS_POR_NIVEL=6
# TAMANHO_LOTE=10
# SEED_BASE=
# MODO_VARIANCIA=

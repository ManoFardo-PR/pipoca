%% Fluxograma — Trilha atual do Pipoca (T1–T10)
%% Azul = fluxo da crianca · Laranja = configuracao do cuidador
%% Violeta = overlay de acessibilidade · Tracejado = voltas e atalhos
flowchart TD
    START([" INICIO — App abre em T2"])

    T2["T2 · Entrada da Crianca<br/>Escolhe avatar ou 'Sou o cuidador'"]
    T3["T3 · Selecao de Cenario<br/>Escolhe o 'Quintal' (outros em breve)"]
    T4["T4 · Heroi / Ambiente<br/>Monta a cena e toca 'Ler em voz alta'"]
    T5["T5 · Portao de Leitura<br/>Le o trecho palavra por palavra"]
    T6["T6 · Recompensa<br/>Ganha vaga-lumes + objeto desbloqueado"]
    T7["T7 · Pote / Cardapio<br/>Guarda ou troca vaga-lumes por premios"]

    T1["T1 · Portao Parental<br/>Digita o PIN de 4 digitos"]
    T10["T10 · Onboarding (Cuidador)<br/>Cria perfil: nome, idade, nivel, avatar"]

    A11Y["PainelA11y · overlay sobre a tela atual<br/>Abre em T3 · T4 · T5 · T7 (botao engrenagem)"]

    %% Fluxo principal da crianca
    START --> T2
    T2 -- "escolhe o avatar" --> T3
    T3 -- "escolhe o cenario" --> T4
    T4 -- "ler em voz alta" --> T5
    T5 -- "confirma a leitura" --> T6
    T6 -- "historia terminou / ver pote" --> T7

    %% Ramo do cuidador
    T2 -- "'Sou o cuidador'" --> T1
    T1 -- "PIN ok + sem perfil" --> T10
    T1 -. "PIN ok + ja existe perfil" .-> T2
    T1 -. "X 'Voltar para a crianca'" .-> T2
    T10 -. "'Tudo pronto' (perfil salvo)" .-> T2

    %% Voltas e atalhos
    T4 -. "< 'Voltar'" .-> T3
    T5 -. "< 'Voltar'" .-> T4
    T6 -. "'Continuar' (historia NAO terminou)" .-> T4
    T7 -. "'Continuar lendo'" .-> T3

    %% Overlay de acessibilidade
    T3 -. "engrenagem" .-> A11Y
    T4 -. "engrenagem" .-> A11Y
    T5 -. "engrenagem" .-> A11Y
    T7 -. "engrenagem" .-> A11Y
    A11Y -. "fecha e volta a tela de origem" .-> T3

    classDef crianca fill:#cfe3ff,stroke:#3b6fb0,color:#10243b;
    classDef cuidador fill:#ffe2c2,stroke:#c97a2b,color:#3b2410;
    classDef overlay fill:#e7d8ff,stroke:#7a52c0,color:#241040;
    classDef inicio fill:#cdeccd,stroke:#3f9142,color:#10331a;

    class START inicio;
    class T2,T3,T4,T5,T6,T7 crianca;
    class T1,T10 cuidador;
    class A11Y overlay;

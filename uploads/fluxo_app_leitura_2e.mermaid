flowchart TD

  subgraph SETUP["⚙️ 0 · Configuração (cuidador)"]
    A1["Cuidador cria perfil da criança"] --> A2["Define nível de leitura, idade e complexidade"]
    A2 --> A3["Escolhe modo de verificação e rigor do portão"]
    A3 --> A4["Monta cardápio de recompensas e duração do bloco"]
  end

  subgraph SESSAO["▶️ 1 · Início de sessão (criança)"]
    B0["Login visual simples"] --> B1["Escolhe cenário / tema"]
    B1 --> B2["Bloco de foco inicia: tempo curto, externalizado (Pomodoro)"]
  end

  subgraph GERACAO["📖 2 · Geração da história"]
    C1{"Origem da história?"}
    C1 -->|MVP| C2["Banco de histórias ramificadas pré-escritas por nível"]
    C1 -->|Fase 2| C3["IA gera narrativa ao vivo, calibrada ao nível de leitura"]
    C2 --> C4["História nível 1 renderizada: fonte grande + TTS de apoio"]
    C3 --> C4
  end

  subgraph LEITURA["🗣️ 3 · Leitura em voz alta — o PORTÃO (Premack)"]
    D1["Criança lê em voz alta"] --> D2{"Modo de verificação"}
    D2 -->|Cuidador no loop · MVP| D3["Cuidador confirma: ouviu / tentou"]
    D2 -->|Autorrelato| D4["Criança toca: eu li"]
    D2 -->|Fala / ASR · Fase 2| D5["ASR avalia participação, não perfeição"]
    D3 --> D6{"Leitura fluiu?"}
    D4 --> D6
    D5 --> D6
    D6 -->|Travou numa palavra| D7["Correção suave: TTS modela a palavra e tenta de novo. Nunca reprova"]
    D6 -->|Participou| D8["💎 Pontos imediatos + elogio específico"]
  end

  subgraph ENRIQUECE["🧩 4 · Enriquecer a história (tarefa invertida)"]
    F1["Criança brinca com objetos e adiciona item / personagem / obstáculo"]
    F1 --> F2["Motor reescreve a história, mais rica e complexa"]
    F2 --> F3{"Modo de desfecho"}
    F3 -->|Convergente: final fixo| F4["Complica, mas mantém o mesmo final (MST)"]
    F3 -->|Aberto| F5["Intenção da criança pode mudar o final"]
    F4 --> F6["Nova versão, mais longa e rica"]
    F5 --> F6
  end

  subgraph FECHA["🏁 5 · Fechamento e evolução"]
    H1["Snapshot: minutos lidos, palavras, histórias, pontos"]
    H1 --> H2["Painel do cuidador: evolução da leitura e engajamento"]
    H1 --> H3{"Resgatar pontos?"}
    H3 -->|Gasta ~2 terços| H4["Troca no cardápio de recompensas de rotina"]
    H3 -->|Poupa ~1 terço| H5["Saldo guardado para recompensa maior"]
    H2 --> H6["Rotação de cenários e recompensas: novidade contra o tédio"]
  end

  %% --- conexões entre as fases ---
  A4 --> B0
  B2 --> C1
  D7 --> D1
  D8 -->|leitura destrava o +elemento| F1
  F6 --> G1{"Bloco de foco ainda ativo?"}
  G1 -->|Sim, próxima leitura| D1
  G1 -->|Não / criança parou| H1

  %% --- legenda visual ---
  classDef fase2 fill:#ede7f6,stroke:#7e57c2,stroke-width:2px,color:#311b5e;
  classDef gate fill:#ffebee,stroke:#e53935,stroke-width:2px,color:#7f1d1d;
  class C3,D5 fase2;
  class D6,D7 gate;
